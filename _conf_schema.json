{
  "enable": {
    "description": "① 启用插件",
    "type": "bool",
    "default": true,
    "obvious_hint": true,
    "hint": "关掉后本插件完全不接管消息，等同于卸载但不丢配置。"
  },
  "active_engine": {
    "description": "② 朗读引擎（说话用）",
    "type": "string",
    "default": "mimo_v2.5",
    "options": [
      "mimo_v2.5",
      "minimax",
      "mimo_v2",
      "openai_tts",
      "volcengine_tts",
      "aliyun_tts",
      "azure_tts",
      "elevenlabs_tts",
      "custom_tts",
      "mimo_design",
      "mimo_clone"
    ],
    "hint": "点选即可，不用打字。候选是各引擎添加时的默认实例名称；如果你改过「实例名称」，选项里没有就手动填那个名字。"
  },
  "singing_engine": {
    "description": "③ 唱歌引擎（可与朗读不同）",
    "type": "string",
    "default": "跟随朗读引擎",
    "options": [
      "跟随朗读引擎",
      "mimo_v2.5",
      "minimax",
      "mimo_v2",
      "openai_tts",
      "volcengine_tts",
      "aliyun_tts",
      "azure_tts",
      "elevenlabs_tts",
      "custom_tts",
      "mimo_design",
      "mimo_clone"
    ],
    "hint": "点选即可。「跟随朗读引擎」= 用②那个引擎唱歌；想分开就选另一个——例如朗读选 mimo_v2.5、这里选 minimax。选到不支持唱歌的引擎会自动回退并记日志。"
  },
  "engines": {
    "type": "template_list",
    "description": "引擎列表（可加多个，朗读与唱歌各挑一个）",
    "templates": {
      "mimo_v2": {
        "name": "[MiMo] V2-TTS",
        "hint": "小米 MiMo V2 语音合成",
        "items": {
          "instance_name": {
            "description": "实例名称（用于标识和切换）",
            "type": "string",
            "default": "mimo_v2"
          },
          "api_key": {
            "description": "API Key",
            "type": "string",
            "default": "",
            "secret": true
          },
          "api_base": {
            "description": "API Base URL",
            "type": "string",
            "default": "https://api.xiaomimimo.com/v1"
          },
          "model": {
            "description": "模型名称",
            "type": "string",
            "default": "mimo-v2-tts"
          },
          "voice": {
            "description": "朗读音色",
            "type": "string",
            "default": "mimo_default",
            "options": [
              "mimo_default",
              "default_zh",
              "default_en"
            ],
            "hint": "只影响朗读。唱歌音色在下一行的「唱歌音色」里单独设。"
          },
          "singing_voice": {
            "description": "唱歌音色（与朗读分开）",
            "type": "string",
            "default": "茉莉",
            "options": [
              "跟随朗读音色",
              "冰糖",
              "茉莉",
              "苏打",
              "白桦",
              "Mia",
              "Chloe",
              "Milo",
              "Dean",
              "mimo_default"
            ],
            "hint": "默认茉莉，和朗读音色互不影响。想跟朗读一致才选「跟随朗读音色」。改完保存后建议重载插件，否则引擎可能仍用旧音色。"
          },
          "format": {
            "description": "输出格式",
            "type": "string",
            "default": "mp3",
            "options": [
              "mp3",
              "wav",
              "pcm16"
            ],
            "hint": "参考项目默认 mp3。mp3 与 wav 的编码不同，长句尾巴的稳定性也不一样——如果唱到后段总是跑调，先把这里换成 mp3 试一次。"
          },
          "timeout": {
            "description": "超时（秒）",
            "type": "int",
            "default": 30,
            "invisible": true
          },
          "overall_tone": {
            "description": "整体语调（全局）",
            "type": "string",
            "default": "不设置",
            "options": [
              "不设置",
              "温柔",
              "高冷",
              "活泼",
              "严肃",
              "慵懒",
              "俏皮",
              "深沉",
              "干练",
              "凌厉"
            ],
            "hint": "朗读和唱歌都会用。写进 user 消息作为演唱/说话指导，不会出现在语音正文里。"
          },
          "timbre_positioning": {
            "description": "音色质感（全局）",
            "type": "string",
            "default": "不设置",
            "options": [
              "不设置",
              "磁性",
              "醇厚",
              "清亮",
              "空灵",
              "稚嫩",
              "苍老",
              "甜美",
              "沙哑",
              "醇雅"
            ],
            "hint": "管声音的「质地」。写进 user 消息作为演唱/说话指导，不会出现在语音正文里。"
          },
          "persona_accent": {
            "description": "人设腔调（全局）",
            "type": "string",
            "default": "不设置",
            "options": [
              "不设置",
              "夹子音",
              "御姐音",
              "正太音",
              "大叔音",
              "台湾腔"
            ],
            "hint": "管「说话的那股劲儿」。写进 user 消息作为演唱/说话指导，不会出现在语音正文里。"
          },
          "dialect": {
            "description": "方言（全局）",
            "type": "string",
            "default": "不设置",
            "options": [
              "不设置",
              "东北话",
              "四川话",
              "河南话",
              "粤语"
            ],
            "hint": "朗读和唱歌都会带上这个口音。写进 user 消息作为演唱/说话指导，不会出现在语音正文里。"
          },
          "role_play": {
            "description": "角色扮演（全局）",
            "type": "string",
            "default": "不设置",
            "hint": "自由填写角色名或描述，例如「孙悟空」「林黛玉」「幼儿园老师」。留「不设置」表示不用。"
          },
          "singing_legacy_mode": {
            "description": "复古模式（默认开启，推荐）",
            "type": "bool",
            "default": true,
            "hint": "默认开启：歌词原样送出，只保留（唱歌）标签 + 一句演唱指令，这条链路实测最好听。上面那五项「全局风格」依然生效，会跟在（唱歌）后面。"
          },
          "singing_voice_lock": {
            "description": "锁定音色不串味",
            "type": "bool",
            "default": true,
            "hint": "开启后会把歌词里的（男声）（换音色）这类标签剔除，避免一句女声一句男声。只做文本清洗，不下发额外指令。"
          },
          "singing_style": {
            "description": "演唱气质（已被上面五项覆盖，通常留「不指定」）",
            "type": "string",
            "default": "不指定",
            "options": [
              "不指定",
              "温柔",
              "深情",
              "清亮",
              "磁性",
              "甜美",
              "慵懒",
              "活泼",
              "沙哑",
              "夹子音",
              "御姐音",
              "正太音",
              "大叔音",
              "台湾腔",
              "东北话",
              "四川话",
              "河南话",
              "粤语"
            ],
            "hint": "上面五个「全局」维度已经覆盖语调/音色/腔调，这项通常用不到，留「不指定」即可。",
            "invisible": true
          },
          "singing_takes": {
            "description": "唱歌候选次数",
            "type": "int",
            "default": 1,
            "hint": "官方说明 TTS 有随机性、同样输入效果可能不同，可多生成几次挑一条。填 2 或 3 会多花钱，但更容易撞到唱得好的那条（取音频最长的一次）。",
            "slider": {
              "min": 1,
              "max": 3,
              "step": 1
            }
          },
          "singing_timeout": {
            "description": "唱歌超时（秒）",
            "type": "int",
            "default": 120,
            "hint": "唱歌是长请求：满预算约 130 字实际要 60~80 秒，低于 120 会有概率超时失败。留 0 也会按 120 保底。",
            "invisible": true
          },
          "style": {
            "description": "风格标签（开心、东北话等，勿填唱歌）",
            "type": "string",
            "default": ""
          },
          "seed_text": {
            "description": "种子文本（影响语气）",
            "type": "text",
            "default": "",
            "invisible": true
          }
        },
        "description": "预置音色 · 不支持唱歌"
      },
